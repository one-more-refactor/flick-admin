# Quadlet unit — ~/.config/containers/systemd/flick-admin.container
# The panel proxies /api to the backend container, so both join flick.network
# and the backend must set ContainerName=flick-backend.
[Unit]
Description=flick admin panel (nginx static + api proxy)

[Container]
Image=ghcr.io/one-more-refactor/flick-admin:latest
# Track the registry digest; podman-auto-update pulls and restarts on change.
# Enable once per host: systemctl --user enable --now podman-auto-update.timer
# Pin to a version tag instead (e.g. :v0.3.0) to freeze this host.
AutoUpdate=registry
ContainerName=flick-admin
Network=flick.network
PublishPort=127.0.0.1:3013:80

[Service]
Restart=always

[Install]
WantedBy=default.target
